FROM python:3.11-slim

WORKDIR /app

# System deps for psycopg (binary)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Poetry lives in its own venv: installed next to the app it shares anyio/certifi/cffi/
# cryptography/idna with it, and `poetry install` then breaks while downgrading them
# to the locked versions (CI failure 2026-10-28).
RUN python -m venv /opt/poetry \
    && /opt/poetry/bin/pip install --no-cache-dir poetry==2.3.2 poetry-plugin-export

# Copy dependency files first (layer cache)
COPY pyproject.toml poetry.lock* ./

# Install exactly the locked versions (dev group included, as before) into the system Python
RUN /opt/poetry/bin/poetry export --with dev --without-hashes -f requirements.txt -o /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# Copy source + Alembic config + entrypoint
COPY src/ ./src/
COPY database/ ./database/
COPY alembic.ini ./alembic.ini
COPY scripts/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# App version — injected at build time via: docker build --build-arg APP_VERSION=v2.0.0
# Baked into the image as an env var so the running container always knows its version.
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}

EXPOSE 8000

# entrypoint: wait-for-db → migrate → seed → uvicorn
# Extra uvicorn flags can be passed as CMD overrides (e.g. --reload in dev)
ENTRYPOINT ["./entrypoint.sh"]
CMD []
